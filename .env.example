# LedgerCore Environment Configuration

# Application
APP_PORT=8000
NGINX_PORT=80
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_TRANSFERS_PER_MINUTE=300

# Database (PostgreSQL)
POSTGRES_USER=ledger_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ledger_core
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ledger_user:change_me_in_production@localhost:5432/ledger_core

# Redis Cache & Rate Limiter
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Broker
RABBITMQ_DEFAULT_USER=ledger_user
RABBITMQ_DEFAULT_PASS=change_me_in_production

# Grafana Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production
